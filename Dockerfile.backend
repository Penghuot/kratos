# Dockerfile for Ory Kratos Backend
# Using official Ory Kratos Docker image
# Railway will clone the repo and use this Dockerfile to build

FROM oryd/kratos:v1.3.0

# Copy the kratos.yml configuration
COPY kratos.yml /etc/config/kratos/kratos.yml

# Copy the identity schema
COPY identity.schema.json /etc/config/kratos/identity.schema.json

# Expose Kratos ports
# 4433 - Public API
# 4434 - Admin API
EXPOSE 4433 4434

# Run Kratos serve with configuration
CMD ["serve", "-c", "/etc/config/kratos/kratos.yml", "--dev", "--watch-courier"]
