# Dockerfile for Ory Kratos Selfservice UI
# Using the official Ory Kratos selfservice UI image
# The UI is maintained as a separate project by Ory

FROM oryd/kratos-selfservice-ui-node:v1.3.0

# Environment variables will be set by Railway
# - KRATOS_PUBLIC_URL
# - KRATOS_BROWSER_URL
# - COOKIE_SECRET
# - CSRF_COOKIE_NAME
# - CSRF_COOKIE_SECRET

# The base image already contains the UI application
# and exposes port 3000 by default

# No additional configuration needed - env vars handle everything
EXPOSE 3000
