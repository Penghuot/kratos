# Dockerfile for Ory Kratos Selfservice UI
# Using the official Ory Kratos selfservice UI image

FROM oryd/kratos-selfservice-ui-node:v1.3.0

# Set working directory
WORKDIR /usr/src/app

# Environment variables will be injected by Railway at runtime:
# - KRATOS_PUBLIC_URL (backend API)
# - KRATOS_BROWSER_URL (this frontend service)
# - COOKIE_SECRET
# - CSRF_COOKIE_NAME
# - CSRF_COOKIE_SECRET

# The base image runs: npm start
# which starts the Express server on PORT (default 3000)

EXPOSE 3000

# Use the default CMD from base image
# CMD ["npm", "start"]
